# Existing HealthyMe Supabase project only. Do not create a replacement backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used only to reproduce canonical hm_users authorization in Next.js.
# Never prefix this with NEXT_PUBLIC_ and never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Branding remains configurable until the final product name is approved.
NEXT_PUBLIC_APP_NAME=HealthyMe
